{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Waypoint",
  "version": "0.1.0",
  "identifier": "com.bigredhacks.waypoint",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Waypoint",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Study navigation coach with Gemini + Presage",
    "longDescription": "Waypoint helps students navigate school logistics and lock-in study sessions with Gemini coaching, Google Calendar/Drive context, and Presage wellness signals.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
